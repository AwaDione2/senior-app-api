PORT=3000

# Supabase (PostgreSQL) — see "Déploiement et stockage des contenus" in the
# technical proposal doc. Copy this file to .env and fill in real values.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Cloudflare R2 (object storage for UGC photos/audio)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=senior-app-content
